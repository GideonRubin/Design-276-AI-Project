{
  "name": "dschool-whiteboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/dev.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx server/src/migrate.ts",
    "seed": "tsx server/src/seed.ts"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@libsql/client": "^0.18.0",
    "hono": "^4.13.8",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "nanoid": "^6.0.1",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "roughjs": "^4.6.6",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
